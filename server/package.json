{
  "name": "mail-management-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the government mail management platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:dev": "node scripts/dev-db.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:import": "node scripts/migrate-sqlite.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "smoke": "node scripts/smoke.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN ../LICENSE",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "imapflow": "^1.2.0",
    "jsonwebtoken": "^9.0.1",
    "mailparser": "^3.15.0",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "otplib": "^12.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "embedded-postgres": "^17.12.0-beta.19",
    "eslint": "^10.15.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
